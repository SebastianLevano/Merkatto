# Per-client configuration. Copy to .env and fill in. NEVER commit the real .env.
# Every Merkatto installation uses the same images; only these values change per business.

# Public domain for this client (Caddy obtains HTTPS automatically). Use :443 domain.
DOMAIN=martita.example.pe
# Full public URL of the SPA (used for CORS). Match the domain above.
PUBLIC_URL=https://martita.example.pe

# --- Database ---
POSTGRES_DB=merkatto
POSTGRES_USER=merkatto
POSTGRES_PASSWORD=change-me-strong-password

# --- Auth ---
# 32+ random chars. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-generate-a-long-random-key
JWT_ISSUER=Merkatto
JWT_AUDIENCE=Merkatto

# --- First-run administrator (seeded once if no users exist) ---
# IMPORTANT: this is YOUR account (system admin), not the client's.
# After first login you must change this password, then create the client's
# account from Configuración → Usuarios with the Collaborator role.
ADMIN_EMAIL=tu@email.com
ADMIN_NAME=Tu Nombre
ADMIN_PASSWORD=change-me-strong-password

# --- Branding (shown in the app header; can also be changed later from Settings) ---
BUSINESS_NAME=Bodega Martita

# --- Backups ---
BACKUP_RETENTION_DAYS=14
