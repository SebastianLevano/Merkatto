# --- Build stage ---
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Runtime stage (static files via Nginx) ---
FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# Angular build output (application builder emits to dist/<app>/browser)
COPY --from=build /app/dist/merkatto-web/browser /usr/share/nginx/html
EXPOSE 8080
