<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1603</NoWarn>

    <!-- Velopack version — bump before every release -->
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>

    <!-- Self-contained only when publishing with a RID (dotnet publish -r win-x64).
         During dev builds (dotnet run / dotnet build) no RID → not self-contained. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.0.0" />
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Merkatto.Api\Merkatto.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- client.json is per-install config (centralBaseUrl, mode). It must NOT be baked into
         the published bundle — each deployment gets its own copy placed next to the exe. -->
    <Content Remove="client.json" />
  </ItemGroup>

  <!-- Drop appsettings pulled in from Merkatto.Api before the duplicate-file
       check runs — Desktop has its own copies that must win. -->
  <Target Name="RemoveApiAppsettingsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="('%(RelativePath)' == 'appsettings.json' Or '%(RelativePath)' == 'appsettings.Development.json')
                   And $([System.String]::Copy('%(Identity)').Contains('Merkatto.Api'))" />
    </ItemGroup>
  </Target>

</Project>
