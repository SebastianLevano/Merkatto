<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress warning about referencing a web executable project -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse all controllers, middleware, and filters from the API layer -->
    <ProjectReference Include="..\Merkatto.Api\Merkatto.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Angular SPA build output is copied here before publish (npm run build → wwwroot/) -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
